# Aplicacion
APP_NAME=bpm-api
APP_ENV=development
APP_VERSION=dev
APP_HOST=0.0.0.0
PORT=8080
API_BASE_PATH=/api/v1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=20s
HTTP_MAX_JSON_BODY_BYTES=1048576
HTTP_RATE_LIMIT_RPS=50
HTTP_RATE_LIMIT_BURST=100
# Mantener false hasta impedir acceso directo al origen por fuera de Cloudflare.
HTTP_TRUST_PROXY_HEADERS=false
HTTP_HSTS_MAX_AGE_SECONDS=31536000

# PostgreSQL
# Local: usar una instancia local o DATABASE_PUBLIC_URL si se habilita
# temporalmente el proxy TCP. En Railway se usa ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://bpm:bpm_local_only@localhost:5433/bpm?sslmode=disable
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT=5s
DB_MAX_CONNECTION_IDLE=5m
DB_MAX_CONNECTION_LIFETIME=30m
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s

# Firebase Auth y FCM
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=CHANGE_ME
# JSON completo de la cuenta de servicio codificado en base64.
# Guardarlo como secreto sellado en Railway y nunca confirmarlo en Git.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=CHANGE_ME

# Cloudflare R2: bucket privado
R2_ENABLED=false
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
R2_SIGNED_URL_TTL=5m
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Correo y observabilidad (opcionales hasta implementar sus modulos)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENTRY_DSN=

